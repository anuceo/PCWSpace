# Delta Agent runtime
DELTA_AGENT_ENV=prod
DELTA_AGENT_CONFIG=./delta-agent/configs/default.toml

# Redis + VDDAB durability
DELTA_AGENT_REDIS_URL=rediss://:<password>@<host>:<port>
DELTA_AGENT_VDDAB_ROOT=./delta-agent/data/vddab

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Real agent gate
DELTA_AGENT_USE_REAL_AGENTS=false

# Notion
NOTION_SYNC_ENABLED=false
NOTION_TOKEN=secret_...
NOTION_DATABASE_ID=
NOTION_ARTIFACTS_DATABASE_ID=
NOTION_PARENT_PAGE_ID=
NOTION_DATABASE_TITLE_PROPERTY=Name
NOTION_API_BASE_URL=https://api.notion.com/v1
NOTION_API_VERSION=2022-06-28
NOTION_TIMEOUT_MS=10000
NOTION_SYNC_MAX_ATTEMPTS=3

# API
PCW_API_KEY=pcw-changeme
PCW_HOST=0.0.0.0
PCW_PORT=8080
PCW_LOG_LEVEL=info

# AuthN/AuthZ middleware
DELTA_AGENT_AUTH_REQUIRED=false
DELTA_AGENT_AUTH_DISABLED=false
DELTA_AGENT_API_KEY=
DELTA_AGENT_API_KEYS=
DELTA_AGENT_READONLY_API_KEY=
DELTA_AGENT_READONLY_API_KEYS=
DELTA_AGENT_ADMIN_API_KEY=
DELTA_AGENT_ADMIN_API_KEYS=

# Worker
WORKER_API_BASE_URL=http://127.0.0.1:8080
WORKER_POLL_INTERVAL_MS=100
WORKER_MAX_CONCURRENCY=8
WORKER_REQUEST_TIMEOUT_MS=30000
WORKER_NOTION_POLL_ENABLED=true

# Security
SESSION_KEY_TTL_SECS=86400
